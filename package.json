{
	"name": "n8n-nodes-aiact",
	"version": "0.1.3",
	"description": "VerifactAI: check AI workflows against the EU AI Act and record auditable evidence",
	"keywords": [
		"n8n-community-node-package",
		"n8n",
		"verifactai",
		"ai-act",
		"compliance",
		"eu-ai-act",
		"governance"
	],
	"license": "MIT",
	"homepage": "https://verifactai.app",
	"author": {
		"name": "NBMethod",
		"email": "contact@nbmethod.com",
		"url": "https://nbmethod.com"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/NBMethod/AI-Act-N8N.git"
	},
	"bugs": {
		"url": "https://github.com/NBMethod/AI-Act-N8N/issues"
	},
	"engines": {
		"node": ">=20.15"
	},
	"scripts": {
		"build": "rimraf dist && tsc && gulp build:icons",
		"dev": "tsc --watch",
		"format": "prettier nodes credentials --write",
		"lint": "eslint nodes credentials",
		"lintfix": "eslint nodes credentials --fix",
		"scan": "npx --yes @n8n/scan-community-package .",
		"test": "vitest run",
		"prepublishOnly": "npm run build && npm run lint"
	},
	"files": [
		"dist",
		"README.md",
		"LICENSE.md",
		"example-workflow.json"
	],
	"n8n": {
		"n8nNodesApiVersion": 1,
		"credentials": [
			"dist/credentials/AiActApi.credentials.js"
		],
		"nodes": [
			"dist/nodes/AiAct/AiAct.node.js"
		]
	},
	"devDependencies": {
		"@n8n/eslint-plugin-community-nodes": "^0.29.0",
		"@typescript-eslint/parser": "^8.0.0",
		"eslint": "^9.29.0",
		"gulp": "^5.0.0",
		"n8n-workflow": "*",
		"prettier": "^3.3.0",
		"rimraf": "^6.0.0",
		"typescript": "^5.9.0",
		"vitest": "^4.0.0"
	},
	"peerDependencies": {
		"n8n-workflow": "*"
	}
}
